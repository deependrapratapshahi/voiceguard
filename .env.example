# --- General ---
APP_NAME=VOICEGUARD
ENV=development
LOG_LEVEL=INFO

# --- Database ---
# Local (non-Docker) default; docker-compose.yml overrides this to point
# at the `postgres` service.
DATABASE_URL=postgresql+asyncpg://voiceguard:voiceguard@localhost:5432/voiceguard

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Security ---
# CHANGE THIS before any non-local deployment. Never commit real secrets.
API_SECRET=change-me-in-.env
CORS_ORIGINS=http://localhost:5173

# --- ML / model management ---
MODEL_PATH=./ml_artifacts
DEEPFAKE_MODEL_VERSION=cnn-baseline-v1
SPEAKER_MODEL_VERSION=baseline-v1
PROSODY_MODEL_VERSION=baseline-v1
# Set to true only if pretrained encoder weights have been downloaded
# locally via scripts/download_models.py -- otherwise the system
# automatically uses the classical baseline models.
USE_PRETRAINED_ENCODERS=false
SPEAKER_SIMILARITY_THRESHOLD=0.55

# --- Audio pipeline ---
TARGET_SAMPLE_RATE=16000
CHUNK_DURATION_SECONDS=2.0
CHUNK_OVERLAP_SECONDS=0.5
MAX_UPLOAD_MB=25

# --- Privacy ---
# 0 = raw audio is never buffered/persisted (recommended default).
RAW_AUDIO_RETENTION_SECONDS=0
FEATURE_ONLY_LOGGING=true
AUDIT_LOG_ENABLED=true

# --- Risk engine weights (the 10 signals combined into the risk score; defaults sum to 1.0) ---
SYNTHETIC_WEIGHT=0.25
SPEAKER_WEIGHT=0.15
PROSODY_WEIGHT=0.08
CALLER_REPUTATION_WEIGHT=0.10
REGISTERED_CONTACT_WEIGHT=0.07
TRANSACTION_WEIGHT=0.15
PRIVILEGED_ACTION_WEIGHT=0.06
URGENCY_WEIGHT=0.05
BYPASS_CALLBACK_WEIGHT=0.06
HISTORICAL_FRAUD_WEIGHT=0.03

# --- Risk level thresholds (score <= threshold maps to that level; above HIGH -> CRITICAL) ---
RISK_THRESHOLD_LOW=30.0
RISK_THRESHOLD_MEDIUM=60.0
RISK_THRESHOLD_HIGH=80.0

# --- Contextual factor scaling ---
TRANSACTION_LOW_THRESHOLD=1000.0
TRANSACTION_HIGH_THRESHOLD=50000.0
HISTORICAL_FRAUD_CAP=5
SPEAKER_UNCERTAIN_LOW=0.35
SPEAKER_UNCERTAIN_HIGH=0.65

# --- Temporal smoothing ---
SMOOTHING_STRATEGY=ema
EMA_ALPHA=0.4
MOVING_AVERAGE_WINDOW=5
